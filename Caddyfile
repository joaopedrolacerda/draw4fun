# Servidor do site em produção: arquivos estáticos de /srv na porta $PORT.
{
	admin off
	# O Railway cuida do HTTPS na frente; aqui é HTTP simples.
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Arquivos com hash no nome nunca mudam: cache longo.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# A página sempre confere se há versão nova.
	@page path / /index.html
	header @page Cache-Control "no-cache"
}
